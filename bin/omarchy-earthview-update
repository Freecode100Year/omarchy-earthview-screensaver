#!/usr/bin/env bash
# Fetch a random high-resolution Google Earth View image for the screensaver.
# Offline, it shows a random image from the local cache instead.

set -euo pipefail

CACHE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-earthview"
JSON_URL="https://raw.githubusercontent.com/limhenry/earthview/master/earthview.json"
MAX_CACHED=20

mkdir -p "$CACHE_DIR"

# Only real JPEG files are used (a proxy or captive portal can answer with HTML).
is_jpeg() { [[ -s $1 && "$(head -c 3 "$1" | od -An -tx1 | tr -d ' \n')" == ffd8ff ]]; }

# Swap the shown image in one step, so the screensaver never reads a half-copied file.
set_current() {
    cp "$1" "$CACHE_DIR/current.jpg.tmp"
    mv -f "$CACHE_DIR/current.jpg.tmp" "$CACHE_DIR/current.jpg"
}

cached_images() { find "$CACHE_DIR" -maxdepth 1 -type f -name '[0-9]*.jpg' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-; }

# Fetch random Earth View image URL
IMG_URL=$(curl -fsSL --connect-timeout 10 --max-time 60 "$JSON_URL" \
    | grep -oE 'https://www\.gstatic\.com/prettyearth/assets/full/[0-9]+\.jpg' \
    | shuf -n 1 || true)

if [[ -n "$IMG_URL" ]]; then
    FILENAME=$(basename "$IMG_URL")
    TMP_FILE="$CACHE_DIR/$FILENAME.tmp"
    TARGET_FILE="$CACHE_DIR/$FILENAME"

    if curl -fsSL --connect-timeout 15 --max-time 120 "$IMG_URL" -o "$TMP_FILE" && is_jpeg "$TMP_FILE"; then
        mv -f "$TMP_FILE" "$TARGET_FILE"
        set_current "$TARGET_FILE"

        # Keep the newest MAX_CACHED images for offline use.
        cached_images | tail -n +$((MAX_CACHED + 1)) | xargs -r -d '\n' rm -f --
        exit 0
    fi
    rm -f "$TMP_FILE"
fi

# Offline fallback: pick a random image from local cache
LOCAL_IMG=$(cached_images | shuf -n 1 || true)
if [[ -n "$LOCAL_IMG" ]]; then
    set_current "$LOCAL_IMG"
fi
exit 0
